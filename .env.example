# =====================================================================
# .env.example
# Copy this file to .env.local and fill in real values there.
# .env.local is already in .gitignore and must never be committed.
#
# Business settings (fund name, Till number, target, reminder days,
# message wording) are NOT here. They live in the database and are
# entered once through the Setup page, so nothing is hard-coded.
# =====================================================================

# ---- Supabase --------------------------------------------------------
# Project URL, from Supabase: Project Settings > API > Project URL.
# Safe to expose to the browser (hence NEXT_PUBLIC_), it is just an address.
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key, from Supabase: Project Settings > API > service_role.
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_. This key bypasses
# Row Level Security, so it must never reach the browser or be logged.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin login -------------------------------------------------------
# Chosen by you. Use a long, random ADMIN_PASSWORD (a password generator
# is fine); it is not a phone number or anything guessable.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Sessions ----------------------------------------------------------
# A long random string used to sign member and admin login cookies.
# Generate one with: openssl rand -base64 48
# Changing this value logs everyone out.
SESSION_SECRET=

# ---- Scheduled jobs ------------------------------------------------------
# A long random string. Vercel sends this automatically as a header to
# /api/cron/daily when it fires; the route rejects any request that
# doesn't include it. Generate one with: openssl rand -base64 32
CRON_SECRET=

# ---- Africa's Talking (SMS) -------------------------------------------
# From your Africa's Talking dashboard. Leave blank until Step 8; the
# app runs in dry-run mode without them.
AT_API_KEY=
AT_USERNAME=
# Optional. Leave blank to send from the default shared number.
AT_SENDER_ID=

# Master safety switch for SMS. Keep this as "false" until you have
# reviewed a dry run and are ready for real messages to go out.
#   false = dry run: messages are built and logged, nothing is sent
#   true  = live: messages are actually sent through Africa's Talking
SMS_LIVE=false

# ---- Daraja (M-PESA API) ------------------------------------------------
# Added in Step 11, once you have Daraja access for the Till. Left blank
# for now; the statement-upload path works fully without these.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
